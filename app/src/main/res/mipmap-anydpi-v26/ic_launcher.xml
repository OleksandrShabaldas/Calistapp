<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground is a raster PNG (the user's own artwork, drawable-nodpi/ic_launcher_foreground.png),
     scaled+centered into the adaptive-icon safe zone at export time — see that file's neighbours for
     the compositing. The <monochrome> layer is the traced "CA" silhouette (ic_launcher_monochrome),
     which Android 13+ themed-icon launchers tint. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
