<?xml version="1.0" encoding="utf-8"?>
<!--
  A media3 PlayerView backed by a TextureView rather than the default SurfaceView.

  A SurfaceView composites on its own hardware layer, so Compose can't reliably draw over it (the
  Next Up card's bottom fade + corner shadow) or clip it to rounded corners, especially inside a
  scrolling screen. A TextureView lives in the normal view tree, so overlays and clipping just work.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom"
    app:shutter_background_color="@android:color/transparent" />
