<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.media3.ui.PlayerView
        android:id="@+id/workout_player"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:surface_type="texture_view" app:use_controller="false"
        app:resize_mode="zoom" app:shutter_background_color="@android:color/transparent" />
    <!-- Keep this fade in sync with workoutScrim() for still-image fallbacks. -->
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/workout_video_scrim" />
    <View android:id="@+id/workout_dim"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#0B0B0C" android:alpha="0" />
</FrameLayout>
