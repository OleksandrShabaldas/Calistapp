<?xml version="1.0" encoding="utf-8"?>
<!--
  The Next Up video with its fade + corner shadow baked into the Android view hierarchy.

  Compose overlays drawn as siblings over the player's TextureView don't reliably composite (a
  content-less gradient Box gets optimised away over the video layer), so the scrims are plain Views
  inside a FrameLayout over the player — ordinary Android z-order, which always draws on top.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/nextup_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="texture_view"
        app:use_controller="false"
        app:resize_mode="zoom"
        app:shutter_background_color="@android:color/transparent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/video_corner_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:background="@drawable/video_bottom_scrim" />
</FrameLayout>
