<?xml version="1.0" encoding="utf-8"?>
<!-- A soft radial shadow anchored at the top-right corner (centre = 1.0, 0.0), fading out, so the
     "NEXT UP" badge always reads over whatever frame is behind it. A radial reads as a real corner
     shadow where a thin diagonal linear gradient did not. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="1.0"
        android:centerY="0.0"
        android:gradientRadius="200dp"
        android:startColor="#A6000000"
        android:endColor="#00000000" />
</shape>
