<!--
  Status-bar notification icon — separate from the launcher icon on purpose. Android renders a
  notification small icon from its ALPHA channel only, flattening it to one system-chosen tint; the
  launcher icon (ic_launcher_foreground, a full-colour raster card) would render as a solid blob here,
  not a mark. So this is the launcher's "CA" monogram as a bare white silhouette, traced from
  drawable-nodpi/ic_launcher_foreground.png (path coordinates are that 1024px image's pixels; the group
  centres them in the 600-unit box). The watch's copy and ic_launcher_monochrome use the same paths —
  change all three together.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="600"
    android:viewportHeight="600">
    <group
        android:translateX="-215"
        android:translateY="-184">
        <!-- C, fused with the A's left leg and apex, and the A's right leg. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M375,340 L582,340 L520,407 L400,407 L323,486 L372,543 L468,543 L582,404 L655,404 L787,628 L720,628 L625,477 L505,607 L342,607 L239,479 Z" />
        <!-- The A's inner notch. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M610,558 L657,558 L692,617 L560,617 Z" />
    </group>
</vector>
