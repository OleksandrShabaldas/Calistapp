<?xml version="1.0" encoding="utf-8"?>
<!--
  Exercise-detail hero bottom fade: the demo media dissolves into the page (#0B0B0C onyx) so the
  overlaid eyebrow + title read and the media's bottom edge disappears. A plain View background
  rather than a Compose scrim, which wouldn't composite over the ExoPlayer texture layer (see
  CLAUDE.md). angle=90 puts startColor at the bottom (near-opaque) fading up to transparent.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#F20B0B0C"
        android:centerColor="#800B0B0C"
        android:endColor="#000B0B0C" />
</shape>
