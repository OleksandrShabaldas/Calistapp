<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent at the top → the card colour (#141317) at the bottom, so the video's lower edge (and
     any seam/watermark) fades into the card instead of ending on a hard line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00141317"
        android:endColor="#FF141317" />
</shape>
