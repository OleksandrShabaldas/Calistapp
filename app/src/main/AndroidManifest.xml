<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- So we can reach FitPal's sync ContentProvider + Health Connect (Android 11+ visibility). -->
    <queries>
        <package android:name="com.fitpal.app" />
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Coarse location is enough to look up local weather/UV/air for the training-recommendations
         widget; it's optional and requested at runtime. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The rest timer's alert. Mid-set you aren't looking at the screen. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Keeps the phone process alive for the length of a workout. Without it the session lived only
      in memory and a backgrounded app killed under pressure lost it outright, while the watch went
      on streaming heart rate to nothing.

      Typed dataSync rather than health: the phone reads no sensors of its own, it maintains the
      data-layer session with the watch. That type carries a daily cap on Android 15, which
      WorkoutSessionService.onTimeout handles by banking the workout rather than dropping it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Last night's sleep, read from Health Connect for the training-readiness widget. Optional:
         denied or unavailable, readiness falls back to training load alone. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <application
        android:name=".CalistApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Calistapp.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Calistapp.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect asks the app to explain why it wants sleep (pre-Android 14). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect permission-usage entry point (Android 14+). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Holds the process open for the duration of a workout. -->
        <service
            android:name=".session.WorkoutSessionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receives real-time HR + session state from the watch over the Wearable Data Layer. -->
        <service
            android:name=".data.sync.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" />
            </intent-filter>
        </service>

        <!-- Hands rendered share-card PNGs to other apps without exposing the cache directory. Own
             subclass so it doesn't collide with the updater module's FileProvider in the merger. -->
        <provider
            android:name=".share.ShareFileProvider"
            android:authorities="${applicationId}.shareprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FitPal's end-of-day nudge lands here (an explicit broadcast) and wakes Calistapp to pull
             the day's steps — even if the app hasn't been opened. Exported because a separate app
             sends it; it carries no data (we pull through the provider), so it needs no sender
             permission — see StepPullReceiver. -->
        <receiver
            android:name=".sync.StepPullReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.calistapp.sync.action.PULL_STEPS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
