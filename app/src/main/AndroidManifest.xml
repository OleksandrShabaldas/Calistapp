<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The rest timer's alert. Mid-set you aren't looking at the screen. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Keeps the phone process alive for the length of a workout. Without it the session lived only
      in memory and a backgrounded app killed under pressure lost it outright, while the watch went
      on streaming heart rate to nothing.

      Typed dataSync rather than health: the phone reads no sensors of its own, it maintains the
      data-layer session with the watch. That type carries a daily cap on Android 15, which
      WorkoutSessionService.onTimeout handles by banking the workout rather than dropping it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".CalistApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Calistapp.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Calistapp.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the process open for the duration of a workout. -->
        <service
            android:name=".session.WorkoutSessionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receives real-time HR + session state from the watch over the Wearable Data Layer. -->
        <service
            android:name=".data.sync.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" />
            </intent-filter>
        </service>
    </application>
</manifest>
